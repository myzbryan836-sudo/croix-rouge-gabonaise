{
  "rewrites": [
    { "source": "/carnet-terrain/(.*)", "destination": "/carnet-terrain/$1" },
    { "source": "/carnet-terrain.apk", "destination": "/carnet-terrain.apk" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}